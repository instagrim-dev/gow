{
  "schema": "g4-open-authoring-unit-request/8",
  "instruction": "Author exactly one assigned open G4 route-intent unit. Return only strict g4-authoring-unit-intent/6 JSON. Copy the assigned id, stratum, and family exactly. Choose one to three declared variables, one or more history_intents, a route recipe_id, typed AST endpoints for every history intent and the route, and a nonempty answer justification. The answer endpoint is HOLDS_ON_DECLARED_DOMAIN. The host derives all starting expressions, rule sequences, bindings, premises, costs, completion records, route states, renderings, and traces. Do not emit episode start_term, catalog, target_cost, history, route endpoint_term, steps, or rule metadata.",
  "response_format": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "stratum",
      "episode",
      "answer",
      "route"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "g4-authoring-unit-intent/6"
      },
      "id": {
        "type": "string",
        "const": "<assigned-id>"
      },
      "stratum": {
        "type": "string",
        "const": "<assigned-stratum>"
      },
      "episode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stratum",
          "family",
          "variables",
          "history_intents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "const": "<assigned-id>"
          },
          "stratum": {
            "type": "string",
            "const": "<assigned-stratum>"
          },
          "family": {
            "type": "string",
            "const": "<assigned-family>"
          },
          "variables": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "history_intents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recipe_id",
                "endpoint"
              ],
              "properties": {
                "recipe_id": {
                  "type": "string",
                  "enum": [
                    "commute-add-eliminate",
                    "commute-xor-eliminate",
                    "commute-add-double-not-eliminate",
                    "commute-add-neg-neg-eliminate",
                    "commute-add-or-self-eliminate",
                    "commute-add-and-self-eliminate",
                    "commute-add-mul-one-eliminate"
                  ]
                },
                "endpoint": {
                  "$ref": "#/$defs/expression"
                }
              }
            }
          }
        }
      },
      "answer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "id",
          "endpoint",
          "justification"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "g4-custodian-answer/1"
          },
          "id": {
            "type": "string",
            "const": "<assigned-id>"
          },
          "endpoint": {
            "type": "string",
            "const": "HOLDS_ON_DECLARED_DOMAIN"
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      },
      "route": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "id",
          "recipe_id",
          "endpoint"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "g4-custodian-route-selection/3"
          },
          "id": {
            "type": "string",
            "const": "<assigned-id>"
          },
          "recipe_id": {
            "type": "string",
            "enum": [
              "commute-add-eliminate",
              "commute-xor-eliminate",
              "commute-add-double-not-eliminate",
              "commute-add-neg-neg-eliminate",
              "commute-add-or-self-eliminate",
              "commute-add-and-self-eliminate",
              "commute-add-mul-one-eliminate"
            ]
          },
          "endpoint": {
            "$ref": "#/$defs/expression"
          }
        }
      }
    },
    "$defs": {
      "expression": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "var"
            ],
            "properties": {
              "var": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "const"
            ],
            "properties": {
              "const": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "not",
                  "neg",
                  "shl1",
                  "shr1"
                ]
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/expression"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "and",
                  "or",
                  "xor",
                  "add",
                  "sub",
                  "mul"
                ]
              },
              "args": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/expression"
                }
              }
            }
          }
        ]
      }
    }
  }
}
