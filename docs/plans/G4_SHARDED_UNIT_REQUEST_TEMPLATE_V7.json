{
  "schema": "g4-sharded-unit-request/7",
  "instruction": "Author exactly one assigned G4 typed-history route-selection unit. Return only strict g4-authoring-unit-intent/5 JSON. Copy the assigned id, stratum, and family exactly. Choose variables, a fully typed nonempty history, one listed recipe_id, an endpoint_term using only the declared variables, and a nonempty answer justification. Every history start must be a recursive expression AST object using exactly one of var, const, or op with args; never emit a compact string for history start. The answer endpoint is HOLDS_ON_DECLARED_DOMAIN. The host independently validates and canonicalizes history starts and expands the selected recipe to exact rules, paths, bindings, premises, catalog, target cost, episode start, and route states. Do not emit episode start_term, catalog, target_cost, steps, or any rule metadata.",
  "response_format": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema",
      "id",
      "stratum",
      "episode",
      "answer",
      "route"
    ],
    "properties": {
      "schema": {
        "type": "string",
        "const": "g4-authoring-unit-intent/5"
      },
      "id": {
        "type": "string",
        "const": "<assigned-id>"
      },
      "stratum": {
        "type": "string",
        "const": "<assigned-stratum>"
      },
      "episode": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "stratum",
          "family",
          "variables",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string",
            "const": "<assigned-id>"
          },
          "stratum": {
            "type": "string",
            "const": "<assigned-stratum>"
          },
          "family": {
            "type": "string",
            "const": "<assigned-family>"
          },
          "variables": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "rules_applied",
                "final_cost",
                "target",
                "completed",
                "endpoint"
              ],
              "properties": {
                "start": {
                  "$ref": "#/$defs/expression"
                },
                "rules_applied": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "double-not",
                      "neg-neg",
                      "add-zero",
                      "sub-zero",
                      "xor-zero",
                      "xor-self-zero",
                      "or-self",
                      "and-self",
                      "mul-one",
                      "mul-zero",
                      "not-intro",
                      "add-comm",
                      "xor-comm"
                    ]
                  }
                },
                "final_cost": {
                  "type": "integer",
                  "minimum": 0
                },
                "target": {
                  "type": "integer",
                  "minimum": 0
                },
                "completed": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                }
              }
            }
          }
        }
      },
      "answer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "id",
          "endpoint",
          "justification"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "g4-custodian-answer/1"
          },
          "id": {
            "type": "string",
            "const": "<assigned-id>"
          },
          "endpoint": {
            "type": "string",
            "const": "HOLDS_ON_DECLARED_DOMAIN"
          },
          "justification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      },
      "route": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "id",
          "recipe_id",
          "endpoint_term"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "const": "g4-custodian-route-selection/2"
          },
          "id": {
            "type": "string",
            "const": "<assigned-id>"
          },
          "recipe_id": {
            "type": "string",
            "enum": [
              "commute-add-eliminate",
              "commute-xor-eliminate",
              "commute-add-double-not-eliminate",
              "commute-add-neg-neg-eliminate",
              "commute-add-or-self-eliminate",
              "commute-add-and-self-eliminate",
              "commute-add-mul-one-eliminate"
            ]
          },
          "endpoint_term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        }
      }
    },
    "$defs": {
      "expression": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "var"
            ],
            "properties": {
              "var": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "const"
            ],
            "properties": {
              "const": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "not",
                  "neg",
                  "shl1",
                  "shr1"
                ]
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "$ref": "#/$defs/expression"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "args"
            ],
            "properties": {
              "op": {
                "type": "string",
                "enum": [
                  "and",
                  "or",
                  "xor",
                  "add",
                  "sub",
                  "mul"
                ]
              },
              "args": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/expression"
                }
              }
            }
          }
        ]
      }
    }
  }
}
